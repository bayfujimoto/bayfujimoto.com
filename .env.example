# Cloudflare R2 public bucket URL — no trailing slash
# e.g. https://pub-xxxx.r2.dev or a custom domain
# Used both at build time (build-data.js) and at runtime (frontend image URLs)
VITE_R2_BASE_URL=

# R2 API credentials — for the r2-upload-url Netlify Function
# Create an API token in Cloudflare dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
