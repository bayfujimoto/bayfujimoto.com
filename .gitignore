node_modules/
dist/
_site/
.cache/
.env
.env.local
.env.*.local

# Netlify CLI state + dev-only filesystem Blobs sandbox (passkey gate).
# The sandbox holds the local-dev credential and challenges — never commit it.
.netlify/
.netlify-blobs-dev/

# Asset binaries — stored in Cloudflare R2, not committed to repo
src/assets/
public/assets/
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.webp
*.glb
*.gltf
# …except the Guide card's desk-object stills: derived from the code's own
# models and look (scripts/render-desk-thumbnails.js), so they version with it.
!public/thumbnails/desk/*.png

# Goodreads export — read by ingest/enrichment, never committed
Goodreads Library Export.csv

# Admin-only archive (all statuses, incl. drafts). Generated each build by
# scripts/build-data.js, bundled into the passkey-gated archive-admin function;
# never served statically, not versioned.
netlify/functions/_admin-archive.json

# Local scratch — repo tarballs and staging for deletion, never committed
_to_delete/
